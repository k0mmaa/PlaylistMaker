<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->

        <item name="android:colorBackground">@color/yp_blue</item>
        <item name="colorOnBackground">@color/yp_white</item>
        <item name="colorPrimary">@color/yp_blue</item>
        <item name="textColorPrimary">@color/yp_white</item>   <!-- текст на тулбаре -->
        <item name="textColorSecondary">@color/yp_black</item> <!-- текст на кнопках -->
        <item name="settingsIconTint">@color/yp_text_gray</item>
        <item name="textColorHint">@color/yp_text_gray</item>
        <item name="colorControlNormal">@color/yp_text_gray</item>
        <item name="colorControlActivated">@color/yp_blue</item>
    </style>

        <!-- Тема для экрана настроек, наследуем от родительской -->
    <style name="Theme.PlaylistMaker.Settings" parent="Base.Theme.PlaylistMaker">
            <item name="android:colorBackground">@color/yp_white</item>
            <item name="colorOnBackground">@color/yp_black</item>
            <item name="textColorPrimary">@color/yp_black</item>         <!-- Для светлой темы -->
            <item name="textColorSecondary">@color/yp_black</item>       <!-- Для светлой темы -->
            <item name="settingsIconTint">@color/yp_text_gray</item>
    </style>

</resources>