<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/parent_layout_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tool_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="24dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="24dp"/>

        <ImageView
            android:id="@+id/backgroundImageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toBottomOf="@id/tool_bar"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"/>

        <TextView
            android:id="@+id/songName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="song name"
            android:textAppearance="@style/ys_medium_22"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/backgroundImageView"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintEnd_toStartOf="@id/right_guideline" />

        <TextView
            android:id="@+id/artistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="bandName"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/ys_medium_14_media"
            app:layout_constraintTop_toBottomOf="@id/songName"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"/>

        <ImageView
            android:id="@+id/queue"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:src="@drawable/ic_add_in_playlist"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintEnd_toStartOf="@id/play"
            app:layout_constraintTop_toTopOf="@id/play"
            app:layout_constraintBottom_toBottomOf="@id/play" />

        <ImageView
            android:id="@+id/play"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_play_btn"
            android:layout_marginTop="36dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/artistName"
            app:layout_constraintEnd_toStartOf="@id/favorite"
            app:layout_constraintStart_toEndOf="@id/queue" />

        <ImageView
            android:id="@+id/favorite"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:src="@drawable/ic_add_in_favorites"
            app:layout_constraintTop_toBottomOf="@id/artistName"
            app:layout_constraintStart_toEndOf="@id/play"
            app:layout_constraintEnd_toEndOf="@id/right_guideline"
            app:layout_constraintTop_toTopOf="@id/play"
            app:layout_constraintBottom_toBottomOf="@id/play"/>

        <TextView
            android:id="@+id/playback_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textAppearance="@style/ys_medium_14_media"
            android:layout_marginBottom="30dp"
            app:layout_constraintTop_toBottomOf="@id/play"
            app:layout_constraintStart_toStartOf="@id/play"
            app:layout_constraintEnd_toEndOf="@id/play"/>


        <TextView
            android:id="@+id/trackTimeMillis"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            app:layout_constraintTop_toBottomOf="@id/play"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/trackTimeMillisLabel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/time_lable"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/playback_time"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/trackTimeMillisValue"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="00:00"
            android:textAppearance="@style/ys_regular_13_media"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/playback_time"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/collectionName"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/collectionName"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/trackTimeMillisLabel"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/collectionNameValue"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/collectionName"
            android:textAppearance="@style/ys_regular_13_media"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/collectionName"
            app:layout_constraintTop_toBottomOf="@id/trackTimeMillisValue" />

        <TextView
            android:id="@+id/releaseDate"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/releaseDate"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/collectionName"/>
        <TextView
            android:id="@+id/releaseDateValue"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/releaseDate"
            android:textAppearance="@style/ys_regular_13_media"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/collectionNameValue"/>

        <TextView
            android:id="@+id/primaryGenreName"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/GenreName"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/releaseDate"/>
        <TextView
            android:id="@+id/primaryGenreNameValue"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/GenreName"
            android:textAppearance="@style/ys_regular_13_media"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/releaseDateValue"/>


        <TextView
            android:id="@+id/countryName"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/countryName"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/primaryGenreName"
            />
        <TextView
            android:id="@+id/countryNameValue"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/countryName"
            android:textAppearance="@style/ys_regular_13_media"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/primaryGenreNameValue"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"/>
    <LinearLayout
        android:id="@+id/playlists_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:behavior_hideable="true"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- заголовок, кнопка, RecyclerView — часть 2 -->
        <TextView
            style="@style/ys_medium_19"
            android:id="@+id/tv_title_playlist_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/add_to_playlist"
            android:layout_marginTop="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_playlist_button_bottom_sheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:text="@string/create_playlist"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Update_Button"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlists_bottom_sheet_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
