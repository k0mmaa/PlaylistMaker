<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->

        <item name="android:colorBackground">@color/yp_black</item>
        <item name="colorOnBackground">@color/yp_white</item>
        <item name="colorPrimary">@color/yp_black</item>
        <item name="textColorPrimary">@color/yp_white</item>   <!-- текст на тулбаре -->
        <item name="textColorSecondary">@color/yp_black</item> <!-- текст на кнопках -->
        <item name="settingsIconTint">@color/yp_white</item>
        <!-- АТРИБУТЫ ДЛЯ ТЕМНОЙ ТЕМЫ -->
        <item name="textColorHint">@color/yp_black</item>      <!-- цвет подсказки -->
        <item name="colorControlNormal">@color/yp_white</item> <!-- цвет иконок -->
        <item name="colorControlActivated">@color/yp_blue</item> <!-- цвет при активации -->
        <item name="colorControlHighlight">@color/yp_blue</item> <!-- цвет при нажатии -->



    </style>

    <!-- Тема для экрана настроек (белый/черный фон) -->
    <style name="Theme.PlaylistMaker.Settings" parent="Base.Theme.PlaylistMaker">
        <item name="textColorRecycleView">@color/yp_white</item>



    </style>
</resources>